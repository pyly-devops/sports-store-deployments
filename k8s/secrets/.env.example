# Credentials for the local Kubernetes deployment.
#
# Copy to `.env` in this directory and fill in real values. `.env` is
# gitignored (see the repo root .gitignore) and MUST NOT be committed --
# "no secrets in git, ever" is a project non-negotiable. `apply-secrets.sh`
# reads this file and creates the two Secrets the cluster needs.
#
# In Milestone 5+ these stop being local files entirely: the values move to
# AWS Secrets Manager and reach pods via the External Secrets Operator, so
# nothing sensitive sits on a laptop either.

# Shared by all five services to sign and verify JWTs. One symmetric secret
# means any service that can verify a token could also forge one -- see the
# engineering log for why that tradeoff is called out rather than hidden.
JWT_SECRET=change-me-to-a-long-random-string

# Root credentials for the Bitnami MongoDB chart. The password ends up in two
# places: the `mongodb-credentials` Secret the chart reads, and inside each
# service's MONGO_URI connection string. apply-secrets.sh writes both from
# this single value so they cannot drift apart.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-too
